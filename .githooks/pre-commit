#!/bin/bash
#
# Pre-commit hook to run TypeScript typechecks and tests before committing
# To bypass: git commit --no-verify
#

echo "Running pre-commit checks..."

FAILED=0

# Run TypeScript tests (Vitest) for packages/server
if [ -d "packages/server/node_modules" ]; then
    echo "Running TypeScript tests for packages/server..."
    (cd packages/server && npm run test) 2>&1
    if [ $? -ne 0 ]; then
        echo "❌ packages/server tests failed."
        FAILED=1
    else
        echo "✅ packages/server tests passed."
    fi
fi

# Run TypeScript typechecks if node_modules exist

# Check packages/shared
if [ -d "packages/shared/node_modules" ]; then
    echo "Running TypeScript typecheck for packages/shared..."
    (cd packages/shared && npx tsc --noEmit) 2>&1
    if [ $? -ne 0 ]; then
        echo "❌ packages/shared typecheck failed."
        FAILED=1
    else
        echo "✅ packages/shared typecheck passed."
    fi
fi

# Check packages/server
if [ -d "packages/server/node_modules" ]; then
    echo "Running TypeScript typecheck for packages/server..."
    (cd packages/server && npx tsc --noEmit) 2>&1
    if [ $? -ne 0 ]; then
        echo "❌ packages/server typecheck failed."
        FAILED=1
    else
        echo "✅ packages/server typecheck passed."
    fi
fi

if [ $FAILED -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit checks failed. Commit aborted."
    echo "   Fix the errors or use 'git commit --no-verify' to bypass."
    exit 1
fi

echo "✅ All checks passed. Proceeding with commit."
exit 0
