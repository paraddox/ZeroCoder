#!/bin/bash
#
# Pre-commit hook to run unit tests before committing
# To bypass: git commit --no-verify
#

echo "Running pre-commit tests..."

# Activate virtual environment if it exists
if [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
fi

# Run unit tests (fast subset for pre-commit)
# Skip slow tests marked with @pytest.mark.slow
python -m pytest tests/unit/ -x -q --tb=line -m "not slow" 2>&1

TEST_EXIT_CODE=$?

if [ $TEST_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ Tests failed. Commit aborted."
    echo "   Fix the failing tests or use 'git commit --no-verify' to bypass."
    exit 1
fi

echo "✅ Tests passed. Proceeding with commit."
exit 0
