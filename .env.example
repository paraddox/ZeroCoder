# ===================
# Anthropic API Key
# ===================

# ANTHROPIC_API_KEY=your-api-key-here

# ===================
# Claude Code Long Term Auth Token
# ===================

# CLAUDE_CODE_OAUTH_TOKEN=

# ===================
# Z.ai API Key (for GLM 4.7 model)
# ===================

# ZHIPU_API_KEY=your-zhipu-api-key-here

# ===================
# MiniMax API Key (for MiniMax M2.1 model)
# ===================

# MINIMAX_API_KEY=your-minimax-api-key-here

# ===================
# SSH Key Path (for Docker image build)
# ===================
# Path to SSH key used for git clone in Docker containers
# Default: $HOME/.ssh/id_ed25519

# GIT_SSH_KEY_PATH=/path/to/your/ssh/key
